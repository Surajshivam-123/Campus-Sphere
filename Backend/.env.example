# Database
MONGODB_URI=mongo_URI

# Server
PORT=4000
NODE_ENV=development

# JWT Secrets (Generate strong random strings)
ACCESS_TOKEN_SECRET=some_string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=some_string
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary
CLOUDINARY_NAME=code-nexin-web
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=secret

# Frontend URLs
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN_WITH_PATH=frontend_URL
# Base path of the frontend app (e.g. /Campus-Sphere for GitHub Pages)
FRONTEND_BASE_PATH=/Campus-Sphere

# Redis (optional — caching layer; app works without it)
# Local:  redis://localhost:6379
# Cloud:  redis://:password@host:6379
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Callback URL must match what you set in Google Cloud Console
GOOGLE_CALLBACK_URL=callback_url

# Email (for OTP login) — use a Gmail App Password
EMAIL_USER=user_mail
EMAIL_PASS=email_pass

# Judge0 (Code Execution Engine for Coding Platform)
# Option 1: Use the free RapidAPI hosted Judge0 CE
#   Sign up at https://rapidapi.com/judge0-official/api/judge0-ce
#   Set JUDGE0_URL to https://judge0-ce.p.rapidapi.com
#   Set JUDGE0_API_KEY to your RapidAPI key
# Option 2: Self-host Judge0 (https://github.com/judge0/judge0)
#   Set JUDGE0_URL to your self-hosted instance URL (e.g. http://localhost:2358)
#   Leave JUDGE0_API_KEY empty
