# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=AppName

# Server
PORT=3000
NODE_ENV=development

# JWT Secrets (Generate strong random strings)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URLs
FRONTEND_ORIGIN=https://yourdomain.github.io
FRONTEND_ORIGIN_WITH_PATH=https://yourdomain.github.io/your-app
# Base path of the frontend app (e.g. /Campus-Sphere for GitHub Pages)
FRONTEND_BASE_PATH=/Campus-Sphere

# Redis (optional — caching layer; app works without it)
# Local:  redis://localhost:6379
# Cloud:  redis://:password@host:6379
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Callback URL must match what you set in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3000/api/cpsh/users/auth/google/callback

# Email (for OTP login) — use a Gmail App Password
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
